# Copy to .env.local for local development. Vite only exposes variables prefixed VITE_, and
# .env.local is gitignored by Vite's own defaults -- never commit the real file.

# The deployed backend's base URL (ADR-005). Points at the live Cloud Run service by default;
# override for a local `uvicorn` instance during development.
VITE_API_BASE_URL=https://myolens-api-ta5ir46azq-ew.a.run.app

# Firebase Web SDK config (ADR-004) -- these are the *client* config values Firebase's own docs
# call "not secret": they identify which Firebase project a browser talks to, not a credential.
# Safe to commit in principle, kept out of the repo anyway so the project's identity isn't tied
# to source control. Get them from the Firebase console: Project settings > General > Your apps >
# Web app > SDK setup and configuration > Config. Every clinician login (and therefore every A3
# participant-scoping check on the backend) depends on these being correct.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
