service-account*.json
gcp-*.json
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
frontend/dist/
*.local

# Firebase emulator (H3 rules tests)
firestore-debug.log
ui-debug.log
firebase-debug.*.log
.firebase/

# Model artefacts: there is no release pipeline that places these on Cloud Run separately from
# the container image (the Dockerfile COPYs backend/artifacts/ directly), and this repository is
# private, so the four frozen artefacts (svm_freq72.onnx, resnet_se_cd.onnx[.data], and the
# training statistics in ood_stats.npz) are tracked directly -- ~7.7 MB combined, trivial for
# git. reference_outputs.npz (the TD-05 equivalence fixture) is tracked for the same reason.
# A stray *.onnx/*.npz dropped into this directory during local experimentation is NOT tracked
# by accident: negations below name only these exact five files.
backend/artifacts/*.onnx
backend/artifacts/*.onnx.data
backend/artifacts/*.npz
!backend/artifacts/svm_freq72.onnx
!backend/artifacts/resnet_se_cd.onnx
!backend/artifacts/resnet_se_cd.onnx.data
!backend/artifacts/ood_stats.npz
!backend/artifacts/reference_outputs.npz

# OS
.DS_Store
Thumbs.db

# TypeScript incremental build artefacts
*.tsbuildinfo
