# Copy to .env for local development. Never commit the real file.
MYOLENS_ENVIRONMENT=development
MYOLENS_GCP_PROJECT_ID=
MYOLENS_GCP_REGION=europe-west1
MYOLENS_STORAGE_BUCKET=

# ensemble (SVM + ResNet-SE+CD soft vote, 0.858 macro-F1 LOSO) or svm_only (0.777, the fallback)
MYOLENS_PREDICTOR=ensemble
